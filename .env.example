# IdentityForge Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================
# Security Settings (REQUIRED)
# ============================================

# Secret key for session signing and encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production-min-32-chars

# Bootstrap secret key for first admin creation
# Use different value than SECRET_KEY
ADMIN_SECRET_KEY=your-admin-secret-key-here-change-this-after-bootstrap

# ============================================
# Database Settings
# ============================================

DATABASE_URL=postgresql+psycopg2://ifora:your-password@localhost:5432/ifora
DATABASE_URL_ASYNC=postgresql+asyncpg://ifora:your-password@localhost:5432/ifora

# ============================================
# Redis Settings
# ============================================

REDIS_URL=redis://localhost:6379/0

# ============================================
# Session Settings
# ============================================

SESSION_COOKIE_NAME=identityforge_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=8

# ============================================
# Rate Limiting
# ============================================

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ============================================
# Default Admin (Bootstrap)
# ============================================

ADMIN_EMAIL=admin@identityforge.local
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Will be set during bootstrap

# ============================================
# Application Settings
# ============================================

ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000