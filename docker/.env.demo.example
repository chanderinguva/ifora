# Reference only. `scripts/demo.sh init` writes the real file to $DEMO_HOME/.env.demo (default ~/ifora-demo/.env.demo)
# with generated secrets, outside the repository. Never reuse values from docker/.env (the dev/prod stack).
PUBLIC_APP_URL=https://demo.ifora.app
OIDC_ISSUER=https://demo.ifora.app
NEXT_PUBLIC_API_URL=https://demo.ifora.app
CORS_ORIGINS=["https://demo.ifora.app"]
FORWARDED_ALLOW_IPS=172.31.77.2
WEBAUTHN_RP_ID=demo.ifora.app
WEBAUTHN_ORIGINS=["https://demo.ifora.app"]
FRONTEND_TARGET=prod
# Sign in through Cloudflare Access: invited people enter one emailed code and land in the app.
ENROLLMENT_CODE_EMAIL=true
ACCESS_SSO_ENABLED=true
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
ACCESS_AUD=
ACCESS_SSO_AUTO_CREATE=true
# Invite by email: the allowlist token (Access: Apps and Policies: Edit only) and the policy to keep in step.
ACCESS_ALLOWLIST_TOKEN=
ACCESS_ALLOWLIST_ACCOUNT_ID=
ACCESS_ALLOWLIST_APP_ID=
ACCESS_ALLOWLIST_POLICY_ID=
# Cloudflare Email Service over SMTP (token needs Email Sending: Edit; the sender domain must be onboarded).
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_IMPLICIT_TLS=true
SMTP_USERNAME=api_token
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Ifora demo
ADMIN_MFA_REQUIRED=true
# No real email from the demo: leave SMTP_* unset.

CLOUDFLARE_TUNNEL_TOKEN=
POSTGRES_PASSWORD=
SECRET_KEY=
ADMIN_SECRET_KEY=
METRICS_TOKEN=
MFA_ENCRYPTION_KEY=
OIDC_KEY_ENCRYPTION_KEY=
SWA_ENCRYPTION_KEY=
RECIPE_ENCRYPTION_KEY=
