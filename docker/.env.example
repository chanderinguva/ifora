# Copy to docker/.env (gitignored) and fill in. Generate each value with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"      # POSTGRES_PASSWORD (hex: URL-safe)
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"  # SECRET_KEY, ADMIN_SECRET_KEY
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # MFA_ENCRYPTION_KEY
#   NOTE: losing/rotating MFA_ENCRYPTION_KEY makes enrolled TOTP secrets undecryptable (users must re-enrol).
POSTGRES_PASSWORD=
SECRET_KEY=
ADMIN_SECRET_KEY=
MFA_ENCRYPTION_KEY=
# OIDC signing-key encryption (a DIFFERENT Fernet key from MFA_ENCRYPTION_KEY):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OIDC_KEY_ENCRYPTION_KEY=
# Encrypts stored passwords for Secure Web Authentication apps (leave empty to disable them). Same generator as MFA_ENCRYPTION_KEY.
# While rotating, move the old value to SWA_ENCRYPTION_KEY_PREVIOUS until users have launched their apps once.
SWA_ENCRYPTION_KEY=

# Recipe engine connection/webhook secrets (a THIRD, different Fernet key; empty = connections and webhook triggers disabled):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECIPE_ENCRYPTION_KEY=

# Admins must have a passkey or authenticator app before the admin area works for them (default: true).
# Set to false only for e2e runs / early bootstrap, e.g. ADMIN_MFA_REQUIRED=false
#ADMIN_MFA_REQUIRED=true

# Optional demo relying party (docker compose --profile demo; see demo/oidc-rp/README.md)
#DEMO_CLIENT_ID=
#DEMO_CLIENT_SECRET=

# Outbound email: recipe "Send an email" step, user invitations and password-reset links (leave SMTP_HOST empty to disable).
# PUBLIC_APP_URL is the web app address placed in those links.
#PUBLIC_APP_URL=http://localhost:3000
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=noreply@example.com
# Recipients must be active users; add external domains here (comma separated) to allow more.
#RECIPES_EMAIL_ALLOWED_DOMAINS=

# Production hardening (behind TLS):
#   SESSION_COOKIE_SECURE=true        send session cookies only over HTTPS
#   FRONTEND_TARGET=prod              compiled `next start` build instead of `next dev`
#   FRONTEND_NODE_ENV=production
#   NEXT_PUBLIC_API_URL=https://api.example.com   (baked into the frontend at build time)
#   PUBLIC_APP_URL=https://app.example.com        (links in emailed invitations and password resets)

# Prometheus: set a random 32+ character token to enable GET /metrics (Authorization: Bearer <token>). Unset = no endpoint.
#METRICS_TOKEN=
