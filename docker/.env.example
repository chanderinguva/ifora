# Copy to docker/.env (gitignored) and fill in. Generate each value with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"      # POSTGRES_PASSWORD (hex: URL-safe)
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"  # SECRET_KEY, ADMIN_SECRET_KEY
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # MFA_ENCRYPTION_KEY
#   NOTE: losing/rotating MFA_ENCRYPTION_KEY makes enrolled TOTP secrets undecryptable (users must re-enrol).
POSTGRES_PASSWORD=
SECRET_KEY=
ADMIN_SECRET_KEY=
MFA_ENCRYPTION_KEY=
# OIDC signing-key encryption (a DIFFERENT Fernet key from MFA_ENCRYPTION_KEY):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OIDC_KEY_ENCRYPTION_KEY=
# Encrypts stored passwords for Secure Web Authentication apps (leave empty to disable them). Same generator as MFA_ENCRYPTION_KEY.
# While rotating, move the old value to SWA_ENCRYPTION_KEY_PREVIOUS until users have launched their apps once.
SWA_ENCRYPTION_KEY=

# Recipe engine connection/webhook secrets (a THIRD, different Fernet key; empty = connections and webhook triggers disabled):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECIPE_ENCRYPTION_KEY=

# Admins must have a passkey or authenticator app before the admin area works for them (default: true).
# Set to false only for e2e runs / early bootstrap, e.g. ADMIN_MFA_REQUIRED=false
#ADMIN_MFA_REQUIRED=true

# Optional demo relying party (docker compose --profile demo; see demo/oidc-rp/README.md)
#DEMO_CLIENT_ID=
#DEMO_CLIENT_SECRET=

# Outbound email: recipe "Send an email" step, user invitations and password-reset links (leave SMTP_HOST empty to disable).
# PUBLIC_APP_URL is the web app address placed in those links.
#PUBLIC_APP_URL=http://localhost:3000
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=noreply@example.com
#SMTP_FROM_NAME=IFora
# Recipients must be active users; add external domains here (comma separated) to allow more.
#RECIPES_EMAIL_ALLOWED_DOMAINS=

# Production hardening (behind TLS):
#   SESSION_COOKIE_SECURE=true        send session cookies only over HTTPS
#   FRONTEND_TARGET=prod              compiled `next start` build instead of `next dev`
#   FRONTEND_NODE_ENV=production
#   NEXT_PUBLIC_API_URL=https://api.example.com   (baked into the frontend at build time)
#   PUBLIC_APP_URL=https://app.example.com        (links in emailed invitations and password resets)

# Prometheus: set a random 32+ character token to enable GET /metrics (Authorization: Bearer <token>). Unset = no endpoint.
#METRICS_TOKEN=

# Production: use docker/docker-compose.prod.yml (see README "Production"). ENVIRONMENT=production refuses to start on
# an unsafe configuration (insecure cookies, weak/placeholder secrets, CORS "*", http:// URLs, ...) and turns off /docs.
# The prod override also requires: PUBLIC_APP_URL, OIDC_ISSUER (https), OIDC_KEY_ENCRYPTION_KEY, FORWARDED_ALLOW_IPS, CORS_ORIGINS.
#CORS_ORIGINS=["https://app.example.com"]
# Behind a reverse proxy, list the proxy's IP so rate limits and IP allow-lists see real client addresses.
#ENVIRONMENT=production
#SESSION_COOKIE_SECURE=true
#FORWARDED_ALLOW_IPS=10.0.0.5
# Passkeys: the RP ID is the host users type in the browser (no scheme or port); origins are exact, a JSON list.
# Without these, passkey enrolment fails on any host other than localhost ("The RP ID ... is invalid for this domain").
#WEBAUTHN_RP_ID=app.example.com
#WEBAUTHN_ORIGINS=["https://app.example.com"]
# Demo environments only: let people invited through Cloudflare Access sign in without a second login. The API verifies
# the Access token itself (team domain + application AUD). Admins, accounts with TOTP and passkey-only accounts are
# never signed in this way. New emails get a non-admin account unless ACCESS_SSO_AUTO_CREATE=false.
#ACCESS_SSO_ENABLED=true
#ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
#ACCESS_AUD=<application AUD tag>
# Keep the Access allowlist in step with the users: creating or inviting a user adds their email to this Access policy,
# deleting them removes it. Use a dedicated Cloudflare API token limited to Access: Apps and Policies: Edit.
#ACCESS_ALLOWLIST_TOKEN=
#ACCESS_ALLOWLIST_ACCOUNT_ID=
#ACCESS_ALLOWLIST_APP_ID=
#ACCESS_ALLOWLIST_POLICY_ID=
# Outbound email (invitations, resets). Cloudflare Email Service over SMTP: host smtp.mx.cloudflare.net, port 465,
# user api_token, password = a Cloudflare API token with Email Sending: Edit; the sender domain must be onboarded.
#SMTP_HOST=smtp.mx.cloudflare.net
#SMTP_PORT=465
#SMTP_IMPLICIT_TLS=true
#SMTP_USERNAME=api_token
#SMTP_PASSWORD=
#SMTP_FROM=noreply@example.com
#SMTP_FROM_NAME=Ifora demo

# New users get the username first.last (numeric suffix on conflict) and the primary email <username>@this domain.
# Leave empty to keep typing emails by hand.
#PRIMARY_EMAIL_DOMAIN=example.com

# The backend ENVIRONMENT flag controls visible environment banners and email subject prefixes.
# Set independently per deployment: demo, development, staging, test, or production.
#ENVIRONMENT=demo

# Optional private dev ingress. Configure Access on ifora.app AND api.ifora.app first.
# See docker/dev-access/README.md. Use the exact unquoted enable line below.
#IFORA_DEV_ACCESS_ENABLED=true
#IFORA_DEV_TUNNEL_TOKEN=
#NEXT_PUBLIC_APP_ENVIRONMENT=development


# Slack message shortcut -> Ifora Discovery (disabled until all values are configured).
#SLACK_IDEA_CAPTURE_ENABLED=false
#SLACK_IDEA_SIGNING_SECRET=
#SLACK_IDEA_ALLOWED_TEAM_ID=
#SLACK_IDEA_ALLOWED_USER_IDS=
#SLACK_IDEA_DELIVERY_TIMEOUT_SECONDS=5
#IFORA_DISCOVERY_INGEST_URL=https://ifora-discovery-hub.chander-inguva.chatgpt.site/api/integrations/slack
#IFORA_DISCOVERY_INGEST_TOKEN=
#IFORA_DISCOVERY_SITES_AUTH_TOKEN=
