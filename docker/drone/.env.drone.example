# Copy to docker/drone/.env.drone (gitignored) and fill in. See docker-compose.drone.yml for the setup steps.
DRONE_SERVER_HOST=drone.ifora.app
DRONE_GITHUB_USER=
DRONE_GITHUB_CLIENT_ID=
DRONE_GITHUB_CLIENT_SECRET=
# openssl rand -hex 16  (shared by the server and the runner)
DRONE_RPC_SECRET=
# Cloudflare tunnel token for drone.ifora.app -> http://drone:80
DRONE_TUNNEL_TOKEN=
